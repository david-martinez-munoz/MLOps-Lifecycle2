# ============================================================
# MLOps-Lifecycle — Variables de entorno
# Copia este archivo a .env (está en .gitignore, no se commitea)
# ============================================================

# ── MLflow / DagsHub (OPCIONAL) ──────────────────────────────
# Sin esto el proyecto funciona igual; solo pierde el tracking de experimentos.
# Crea cuenta gratis en https://dagshub.com (login con GitHub)
# y crea un repo conectado al tuyo para obtener la URI.

# MLFLOW_TRACKING_URI=https://dagshub.com/TU_USUARIO/MLOps-Lifecycle.mlflow
# MLFLOW_TRACKING_USERNAME=TU_USUARIO_DAGSHUB
# MLFLOW_TRACKING_PASSWORD=TU_TOKEN_DAGSHUB
# MLFLOW_MODEL_NAME=sentiment-model
